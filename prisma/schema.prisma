generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "finflow"]
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER

  @@map("fin_user_role")
  @@schema("public")
}

enum CostCenterType {
  COST
  REVENUE

  @@map("fin_cost_center_type")
  @@schema("public")
}

enum InvoiceDirection {
  ACTIVE
  PASSIVE

  @@map("fin_invoice_direction")
  @@schema("public")
}

enum InvoiceStatus {
  PAID
  PENDING

  @@map("fin_invoice_status")
  @@schema("public")
}

enum ExpenseFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM

  @@map("fin_expense_frequency")
  @@schema("public")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SOFTWARE
  HARDWARE
  INSURANCE
  TAXES
  CONSULTING
  MARKETING
  TRAVEL
  TRAINING
  OTHER

  @@map("fin_expense_category")
  @@schema("public")
}

enum ReceivableStatus {
  PENDING
  INVOICED
  CANCELLED

  @@map("fin_receivable_status")
  @@schema("public")
}

enum PayableStatus {
  ACTIVE
  EXHAUSTED
  CANCELLED

  @@map("fin_payable_status")
  @@schema("public")
}

// ─── V2 Enums ───────────────────────────────────────────────

enum UserType {
  CONTROLLER
  CLIENT_OWNER
  CLIENT_ADMIN_BANK_ONLY

  @@map("fin_user_type")
  @@schema("public")
}

enum CdgGranularity {
  MONTHLY
  QUARTERLY

  @@map("fin_cdg_granularity")
  @@schema("public")
}

enum CdgCategory {
  REVENUE
  VAR_COST_MATERIALS
  VAR_COST_SERVICES
  VAR_COST_DIRECT_LABOR
  FIXED_COST_DEPRECIATION
  FIXED_COST_ADMIN_COMPENSATION
  FIXED_COST_RENT
  FIXED_COST_UTILITIES
  FIXED_COST_INSURANCE
  FIXED_COST_CONSULTING
  FIXED_COST_MARKETING
  FIXED_COST_GENERAL
  FINANCIAL_INCOME
  FINANCIAL_EXPENSE
  EXTRAORDINARY_INCOME
  EXTRAORDINARY_EXPENSE
  TAX_INCOME

  @@map("cdg_category")
  @@schema("finflow")
}

// ─── V2 Models (finflow schema) ─────────────────────────────

model AccountingFirm {
  id        String   @id @default(cuid())
  name      String
  vatNumber String?  @map("vat_number")
  email     String?
  phone     String?
  branding  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations   Organization[]
  users           User[]
  clientGroups    ClientGroup[]
  pdfBankProfiles PdfBankProfile[]

  @@map("accounting_firm")
  @@schema("finflow")
}

model ClientGroup {
  id               String   @id @default(cuid())
  name             String
  accountingFirmId String   @map("accounting_firm_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accountingFirm AccountingFirm @relation(fields: [accountingFirmId], references: [id], onDelete: Cascade)
  organizations  Organization[]

  @@map("client_group")
  @@schema("finflow")
}

model TrialBalanceSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  uploadedById   String   @map("uploaded_by_id")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  sourceFilename String   @map("source_filename")
  isLocked       Boolean  @default(false) @map("is_locked")
  isTrusted      Boolean  @default(false) @map("is_trusted")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  lines        TrialBalanceLine[]

  @@index([organizationId, periodEnd])
  @@map("trial_balance_snapshot")
  @@schema("finflow")
}

model TrialBalanceLine {
  id          String       @id @default(cuid())
  snapshotId  String       @map("snapshot_id")
  accountCode String       @map("account_code")
  accountName String       @map("account_name")
  debit       Decimal      @default(0) @db.Decimal(15, 2)
  credit      Decimal      @default(0) @db.Decimal(15, 2)
  balance     Decimal      @default(0) @db.Decimal(15, 2)
  cdgCategory CdgCategory? @map("cdg_category")

  snapshot TrialBalanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("trial_balance_line")
  @@schema("finflow")
}

model ChartOfAccountsMapping {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  accountCode    String      @map("account_code")
  accountName    String      @map("account_name")
  cdgCategory    CdgCategory @map("cdg_category")
  isVatable      Boolean     @default(false) @map("is_vatable")
  vatRate        Decimal?    @map("vat_rate") @db.Decimal(5, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountCode])
  @@map("chart_of_accounts_mapping")
  @@schema("finflow")
}

model MonthlyBudget {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  year           Int
  month          Int         // 1-12
  cdgCategory    CdgCategory @map("cdg_category")
  amount         Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month, cdgCategory])
  @@index([organizationId, year])
  @@map("monthly_budget")
  @@schema("finflow")
}

model F24Schedule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  periodLabel    String   @map("period_label")
  codiceTributo  String?  @map("codice_tributo")
  amount         Decimal  @db.Decimal(12, 2)
  dueDate        DateTime @map("due_date") @db.Date
  isPaid         Boolean  @default(false) @map("is_paid")
  paidDate       DateTime? @map("paid_date") @db.Date
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, dueDate])
  @@map("f24_schedule")
  @@schema("finflow")
}

enum LoanFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL

  @@schema("finflow")
}

model LoanSchedule {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  loanName       String        @map("loan_name")
  bankName       String?       @map("bank_name")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(15, 2)
  installment    Decimal       @db.Decimal(12, 2)
  principal      Decimal?      @db.Decimal(12, 2)
  interest       Decimal?      @db.Decimal(12, 2)
  frequency      LoanFrequency @default(MONTHLY)
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  dayOfMonth     Int?          @map("day_of_month")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("loan_schedule")
  @@schema("finflow")
}

// ─── Fase 6 ────────────────────────────────────────────────

model PdfBankProfile {
  id               String   @id @default(cuid())
  accountingFirmId String?  @map("accounting_firm_id")
  bankName         String   @map("bank_name")
  layoutPatterns   Json     @map("layout_patterns")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accountingFirm AccountingFirm? @relation(fields: [accountingFirmId], references: [id])

  @@unique([accountingFirmId, bankName])
  @@map("pdf_bank_profile")
  @@schema("finflow")
}

model MovementPattern {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  descriptionRegex String   @map("description_regex")
  cdgCategory      String   @map("cdg_category")
  vatRate          Decimal? @map("vat_rate") @db.Decimal(5, 2)
  priority         Int      @default(100)
  isActive         Boolean  @default(true) @map("is_active")
  matchCount       Int      @default(0) @map("match_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("movement_pattern")
  @@schema("finflow")
}

// ─── Models ───────���─────────────────────────────────────────

model Organization {
  id               String          @id @default(cuid())
  name             String
  vatNumber        String?         @map("vat_number")
  address          String?
  city             String?
  province         String?
  zipCode          String?         @map("zip_code")
  country          String          @default("IT")
  email            String?
  phone            String?
  settings         Json            @default("{}")
  // V2 multi-tenant columns
  accountingFirmId String?         @map("accounting_firm_id")
  clientGroupId    String?         @map("client_group_id")
  cdgGranularity   CdgGranularity? @default(MONTHLY) @map("cdg_granularity")
  cashThresholdEur Decimal?        @map("cash_threshold_eur") @db.Decimal(12, 2)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // V2 relations
  accountingFirm   AccountingFirm? @relation(fields: [accountingFirmId], references: [id])
  clientGroup      ClientGroup?    @relation(fields: [clientGroupId], references: [id])

  users                User[]
  costCenters          CostCenter[]
  invoices             Invoice[]
  recurringExpenses    RecurringExpense[]
  oneOffExpenses       OneOffExpense[]
  bankStatements       BankStatement[]
  cashflowSnapshots    CashflowSnapshot[]
  forecastScenarios    ForecastScenario[]
  futureReceivables    FutureReceivable[]
  expectedPayables     ExpectedPayable[]
  vatSnapshots         VatSnapshot[]
  bankAccounts         BankAccount[]
  dataPeriods          DataPeriod[]
  // V2 Fase 2
  trialBalanceSnapshots TrialBalanceSnapshot[]
  chartOfAccountsMappings ChartOfAccountsMapping[]
  // V2 Fase 5
  monthlyBudgets       MonthlyBudget[]
  f24Schedules         F24Schedule[]
  loanSchedules        LoanSchedule[]
  // V2 Fase 6
  movementPatterns     MovementPattern[]

  @@map("fin_organization")
  @@schema("public")
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  passwordHash     String?      @map("password_hash")
  role             UserRole     @default(VIEWER)
  organizationId   String       @map("organization_id")
  emailVerified    DateTime?    @map("email_verified")
  image            String?
  // V2 multi-tenant columns
  userType         UserType?    @map("user_type")
  accountingFirmId String?      @map("accounting_firm_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingFirm AccountingFirm? @relation(fields: [accountingFirmId], references: [id])
  accounts       Account[]
  sessions       Session[]
  // V2 Fase 2
  uploadedSnapshots TrialBalanceSnapshot[]

  @@map("fin_user")
  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("fin_account")
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fin_session")
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("fin_verification_token")
  @@schema("public")
}

model CostCenter {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  type           CostCenterType
  color          String         @default("#6B7280")
  keywords       String[]       @default([])
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recurringExpenses  RecurringExpense[]
  oneOffExpenses     OneOffExpense[]
  bankStatements     BankStatement[]
  futureReceivables  FutureReceivable[]
  expectedPayables   ExpectedPayable[]

  @@unique([organizationId, name])
  @@map("fin_cost_center")
  @@schema("public")
}

model Invoice {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  direction      InvoiceDirection
  status         InvoiceStatus    @default(PENDING)
  number         String
  date           DateTime
  dueDate        DateTime?        @map("due_date")
  netAmount      Decimal          @map("net_amount") @db.Decimal(12, 2)
  vatAmount      Decimal          @map("vat_amount") @db.Decimal(12, 2)
  grossAmount    Decimal          @map("gross_amount") @db.Decimal(12, 2)
  bankAccountId  String?          @map("bank_account_id")
  paidAt         DateTime?        @map("paid_at")
  notes          String?
  // V2 — data freezing
  isFrozen       Boolean?         @default(false) @map("is_frozen")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?      @relation(fields: [bankAccountId], references: [id])
  futureReceivables FutureReceivable[]

  @@index([organizationId, direction])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@map("fin_invoice")
  @@schema("public")
}

model RecurringExpense {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  name            String
  category        ExpenseCategory
  frequency       ExpenseFrequency
  amount          Decimal          @db.Decimal(12, 2)
  vatIncluded     Boolean          @default(true) @map("vat_included")
  costCenterId    String?          @map("cost_center_id")
  startDate       DateTime         @map("start_date")
  endDate         DateTime?        @map("end_date")
  dayOfMonth      Int?             @map("day_of_month")
  customDays      Int?             @map("custom_days")
  description     String?
  counterpart     String?
  // V2 — data freezing
  isFrozen        Boolean?         @default(false) @map("is_frozen")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id])

  @@map("fin_recurring_expense")
  @@schema("public")
}

model OneOffExpense {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  vatIncluded    Boolean         @default(true) @map("vat_included")
  costCenterId   String?         @map("cost_center_id")
  date           DateTime
  isPaid         Boolean         @default(false) @map("is_paid")
  paidAt         DateTime?       @map("paid_at")
  description    String?
  counterpart    String?
  // V2 — data freezing
  isFrozen       Boolean?        @default(false) @map("is_frozen")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])

  @@map("fin_one_off_expense")
  @@schema("public")
}

model BankStatement {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  bankAccountId  String?  @map("bank_account_id")
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(12, 2)
  balance        Decimal  @db.Decimal(12, 2)
  netAmount      Decimal? @map("net_amount") @db.Decimal(12, 2)
  vatAmount      Decimal? @map("vat_amount") @db.Decimal(12, 2)
  cdgCategory    String?  @map("cdg_category") // CdgCategory enum stored as text (cross-schema)
  costCenterId   String?  @map("cost_center_id")
  reference      String?
  sourceFile     String?  @map("source_file")
  fingerprint    String?
  isReconciled   Boolean  @default(false) @map("is_reconciled")
  // V2 — data freezing
  isFrozen       Boolean? @default(false) @map("is_frozen")
  createdAt      DateTime @default(now()) @map("created_at")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount?     @relation(fields: [bankAccountId], references: [id])
  costCenter       CostCenter?      @relation(fields: [costCenterId], references: [id])

  @@index([organizationId, date])
  @@index([organizationId, isReconciled], map: "idx_bank_statement_reconciled", where: raw("(is_reconciled = false)"))
  @@index([organizationId, fingerprint])
  @@map("fin_bank_statement")
  @@schema("public")
}

model CashflowSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  date           DateTime
  inflows        Decimal  @db.Decimal(12, 2)
  outflows       Decimal  @db.Decimal(12, 2)
  netFlow        Decimal  @map("net_flow") @db.Decimal(12, 2)
  balance        Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("fin_cashflow_snapshot")
  @@schema("public")
}

model ForecastScenario {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  parameters     Json     @default("{}")
  results        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fin_forecast_scenario")
  @@schema("public")
}

model FutureReceivable {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  description         String
  counterpart         String
  estimatedAmount     Decimal          @map("estimated_amount") @db.Decimal(12, 2)
  expectedInvoiceDate DateTime?        @map("expected_invoice_date")
  expectedPaymentDate DateTime?        @map("expected_payment_date")
  status              ReceivableStatus @default(PENDING)
  costCenterId        String?          @map("cost_center_id")
  invoiceId           String?          @map("invoice_id")
  notes               String?
  includeInForecast   Boolean          @default(true) @map("include_in_forecast")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fin_future_receivable")
  @@schema("public")
}

// ─── Fatture Passive Attese ──────────────────────────────────

model ExpectedPayable {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  description      String
  counterpart      String
  amount           Decimal          @db.Decimal(12, 2)
  frequency        ExpenseFrequency @default(MONTHLY)
  dayOfMonth       Int?             @map("day_of_month")
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  status           PayableStatus    @default(ACTIVE)
  costCenterId     String?          @map("cost_center_id")
  category         ExpenseCategory  @default(CONSULTING)
  notes            String?
  includeInForecast Boolean         @default(true) @map("include_in_forecast")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fin_expected_payable")
  @@schema("public")
}

// ─── Fase 2: Snapshot IVA ───────────────────────────────────

model VatSnapshot {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  periodType      String   @map("period_type")
  vatDebit        Decimal  @default(0) @map("vat_debit") @db.Decimal(15, 2)
  vatCredit       Decimal  @default(0) @map("vat_credit") @db.Decimal(15, 2)
  vatBalance      Decimal  @default(0) @map("vat_balance") @db.Decimal(15, 2)
  carryForward    Decimal  @default(0) @map("carry_forward") @db.Decimal(15, 2)
  amountDue       Decimal  @default(0) @map("amount_due") @db.Decimal(15, 2)
  dueDate         DateTime? @map("due_date") @db.Date
  isPaid          Boolean  @default(false) @map("is_paid")
  paidDate        DateTime? @map("paid_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  // Fase 5 enhancements
  sourceType      String   @default("invoice") @map("source_type")
  label           String?
  surchargeAmount Decimal  @default(0) @map("surcharge_amount") @db.Decimal(15, 2)
  creditCarriedOut Decimal @default(0) @map("credit_carried_out") @db.Decimal(15, 2)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("fin_vat_snapshot")
  @@schema("public")
}

// ─── Fase 3: Onboarding + Dati Bancari Reali ─────────────

enum BalanceSource {
  EC_ANNUAL
  EC_QUARTERLY
  MANUAL

  @@map("fin_balance_source")
  @@schema("public")
}

enum DataPeriodType {
  EC_ANNUAL
  EC_QUARTERLY
  MOVEMENTS_CSV

  @@map("fin_data_period_type")
  @@schema("public")
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  bankName       String   @map("bank_name")
  iban           String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closingBalances  BalanceSnapshot[]
  bankProfile      BankProfile?
  bankStatements   BankStatement[]
  invoices         Invoice[]

  @@map("fin_bank_account")
  @@schema("public")
}

model BalanceSnapshot {
  id            String        @id @default(cuid())
  bankAccountId String        @map("bank_account_id")
  date          DateTime      @db.Date
  balance       Decimal       @db.Decimal(15, 2)
  source        BalanceSource
  period        String?
  sourceFile    String?       @map("source_file")
  createdAt     DateTime      @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, date, source])
  @@map("fin_balance_snapshot")
  @@schema("public")
}

model BankProfile {
  id                   String   @id @default(cuid())
  bankAccountId        String   @unique @map("bank_account_id")
  bankName             String   @map("bank_name")
  columnMapping        Json     @map("column_mapping")
  dateFormat           String   @default("dd/MM/yyyy") @map("date_format")
  delimiter            String   @default(",")
  decimalSeparator     String   @default(",") @map("decimal_separator")
  skipRows             Int      @default(0) @map("skip_rows")
  descriptionPatterns  Json?    @map("description_patterns")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("fin_bank_profile")
  @@schema("public")
}

model DataPeriod {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  type           DataPeriodType
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  sourceFile     String?        @map("source_file")
  recordCount    Int?           @map("record_count")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("fin_data_period")
  @@schema("public")
}

