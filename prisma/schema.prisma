generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "finflow"]
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER

  @@map("fin_user_role")
  @@schema("public")
}

enum ConnectorType {
  FATTURE_IN_CLOUD
  CSV_IMPORT
  MANUAL

  @@map("fin_connector_type")
  @@schema("public")
}

enum CostCenterType {
  COST
  REVENUE

  @@map("fin_cost_center_type")
  @@schema("public")
}

enum InvoiceDirection {
  ACTIVE
  PASSIVE

  @@map("fin_invoice_direction")
  @@schema("public")
}

enum InvoiceStatus {
  PAID
  PENDING

  @@map("fin_invoice_status")
  @@schema("public")
}

enum ExpenseFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM

  @@map("fin_expense_frequency")
  @@schema("public")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SOFTWARE
  HARDWARE
  INSURANCE
  TAXES
  CONSULTING
  MARKETING
  TRAVEL
  TRAINING
  OTHER

  @@map("fin_expense_category")
  @@schema("public")
}

enum ReceivableStatus {
  PENDING
  INVOICED
  CANCELLED

  @@map("fin_receivable_status")
  @@schema("public")
}

enum PayableStatus {
  ACTIVE
  EXHAUSTED
  CANCELLED

  @@map("fin_payable_status")
  @@schema("public")
}

// ─── V2 Enums ───────────────────────────────────────────────

enum UserType {
  CONTROLLER
  CLIENT_OWNER
  CLIENT_ADMIN_BANK_ONLY

  @@map("fin_user_type")
  @@schema("public")
}

enum CdgGranularity {
  MONTHLY
  QUARTERLY

  @@map("fin_cdg_granularity")
  @@schema("public")
}

// ─── V2 Models (finflow schema) ─────────────────────────────

model AccountingFirm {
  id        String   @id @default(cuid())
  name      String
  vatNumber String?  @map("vat_number")
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations Organization[]
  users         User[]
  clientGroups  ClientGroup[]

  @@map("accounting_firm")
  @@schema("finflow")
}

model ClientGroup {
  id               String   @id @default(cuid())
  name             String
  accountingFirmId String   @map("accounting_firm_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accountingFirm AccountingFirm @relation(fields: [accountingFirmId], references: [id], onDelete: Cascade)
  organizations  Organization[]

  @@map("client_group")
  @@schema("finflow")
}

// ─── Models ─────────────────────────────────────────────────

model Organization {
  id               String          @id @default(cuid())
  name             String
  vatNumber        String?         @map("vat_number")
  address          String?
  city             String?
  province         String?
  zipCode          String?         @map("zip_code")
  country          String          @default("IT")
  email            String?
  phone            String?
  settings         Json            @default("{}")
  // V2 multi-tenant columns
  accountingFirmId String?         @map("accounting_firm_id")
  clientGroupId    String?         @map("client_group_id")
  cdgGranularity   CdgGranularity? @default(MONTHLY) @map("cdg_granularity")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // V2 relations
  accountingFirm   AccountingFirm? @relation(fields: [accountingFirmId], references: [id])
  clientGroup      ClientGroup?    @relation(fields: [clientGroupId], references: [id])

  users                User[]
  connectors           Connector[]
  costCenters          CostCenter[]
  invoices             Invoice[]
  recurringExpenses    RecurringExpense[]
  oneOffExpenses       OneOffExpense[]
  bankStatements       BankStatement[]
  cashflowSnapshots    CashflowSnapshot[]
  forecastScenarios    ForecastScenario[]
  futureReceivables    FutureReceivable[]
  expectedPayables     ExpectedPayable[]
  paymentEvents        PaymentEvent[]
  vatSnapshots         VatSnapshot[]
  bankAccounts         BankAccount[]
  dataPeriods          DataPeriod[]
  dismissedMatches     DismissedMatch[]

  @@map("fin_organization")
  @@schema("public")
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  passwordHash     String?      @map("password_hash")
  role             UserRole     @default(VIEWER)
  organizationId   String       @map("organization_id")
  emailVerified    DateTime?    @map("email_verified")
  image            String?
  // V2 multi-tenant columns
  userType         UserType?    @map("user_type")
  accountingFirmId String?      @map("accounting_firm_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingFirm AccountingFirm? @relation(fields: [accountingFirmId], references: [id])
  accounts       Account[]
  sessions       Session[]

  @@map("fin_user")
  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("fin_account")
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fin_session")
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("fin_verification_token")
  @@schema("public")
}

model Connector {
  id              String        @id @default(cuid())
  organizationId  String        @map("organization_id")
  type            ConnectorType
  name            String
  encryptedConfig String?       @map("encrypted_config")
  isActive        Boolean       @default(true) @map("is_active")
  lastSyncAt      DateTime?     @map("last_sync_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fin_connector")
  @@schema("public")
}

model CostCenter {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  type           CostCenterType
  color          String         @default("#6B7280")
  keywords       String[]       @default([])
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  recurringExpenses  RecurringExpense[]
  oneOffExpenses     OneOffExpense[]
  bankStatements     BankStatement[]
  futureReceivables  FutureReceivable[]
  expectedPayables   ExpectedPayable[]

  @@unique([organizationId, name])
  @@map("fin_cost_center")
  @@schema("public")
}

model Invoice {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  direction      InvoiceDirection
  status         InvoiceStatus    @default(PENDING)
  number         String
  date           DateTime
  dueDate        DateTime?        @map("due_date")
  counterpart    String
  vatNumber      String?          @map("vat_number")
  description    String?
  netAmount      Decimal          @map("net_amount") @db.Decimal(12, 2)
  vatAmount      Decimal          @map("vat_amount") @db.Decimal(12, 2)
  grossAmount    Decimal          @map("gross_amount") @db.Decimal(12, 2)
  costCenterId   String?          @map("cost_center_id")
  needsTagging   Boolean          @default(false) @map("needs_tagging")
  paidAt         DateTime?        @map("paid_at")
  connectorRef   String?          @map("connector_ref")
  documentType   String?          @map("document_type")
  // Fase 2 — DSO override
  expectedCollectionDate DateTime? @map("expected_collection_date") @db.Date
  counterpartCustomDso   Int?      @map("counterpart_custom_dso")
  // Fase 2 — Sofisticazioni bancarie
  isDiscountedAtBank     Boolean   @default(false) @map("is_discounted_at_bank")
  bankDiscountType       String?   @map("bank_discount_type")
  bankLiquidationDate    DateTime? @map("bank_liquidation_date") @db.Date
  bankDiscountFee        Decimal?  @map("bank_discount_fee") @db.Decimal(15, 2)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter         CostCenter?        @relation(fields: [costCenterId], references: [id])
  lines              InvoiceLine[]
  bankStatements     BankStatement[]
  futureReceivables  FutureReceivable[]
  paymentEvents      PaymentEvent[]

  @@index([organizationId, direction])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@map("fin_invoice")
  @@schema("public")
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String  @map("invoice_id")
  description  String
  quantity     Decimal @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal @db.Decimal(12, 2)
  costCenterId String? @map("cost_center_id")

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@map("fin_invoice_line")
  @@schema("public")
}

model RecurringExpense {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  name            String
  category        ExpenseCategory
  frequency       ExpenseFrequency
  amount          Decimal          @db.Decimal(12, 2)
  vatIncluded     Boolean          @default(true) @map("vat_included")
  costCenterId    String?          @map("cost_center_id")
  startDate       DateTime         @map("start_date")
  endDate         DateTime?        @map("end_date")
  dayOfMonth      Int?             @map("day_of_month")
  customDays      Int?             @map("custom_days")
  description     String?
  counterpart     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id])
  bankStatements BankStatement[]

  @@map("fin_recurring_expense")
  @@schema("public")
}

model OneOffExpense {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  vatIncluded    Boolean         @default(true) @map("vat_included")
  costCenterId   String?         @map("cost_center_id")
  date           DateTime
  isPaid         Boolean         @default(false) @map("is_paid")
  paidAt         DateTime?       @map("paid_at")
  description    String?
  counterpart    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])
  paymentEvents  PaymentEvent[]

  @@map("fin_one_off_expense")
  @@schema("public")
}

model BankStatement {
  id                    String       @id @default(cuid())
  organizationId        String       @map("organization_id")
  bankAccountId         String?      @map("bank_account_id")
  date                  DateTime
  description           String
  amount                Decimal      @db.Decimal(12, 2)
  balance               Decimal      @db.Decimal(12, 2)
  costCenterId          String?      @map("cost_center_id")
  reference             String?
  sourceFile            String?      @map("source_file")
  fingerprint           String?
  isReconciled          Boolean      @default(false) @map("is_reconciled")
  reconciledInvoiceId   String?      @map("reconciled_invoice_id")
  reconciledInvoiceIds  String[]     @default([]) @map("reconciled_invoice_ids")
  reconciledExpenseId   String?      @map("reconciled_expense_id")
  reconciledType        String?      @map("reconciled_type")
  reconciledAt          DateTime?    @map("reconciled_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?      @relation(fields: [bankAccountId], references: [id])
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id])
  reconciledInvoice Invoice?          @relation(fields: [reconciledInvoiceId], references: [id], onUpdate: NoAction, map: "fk_bank_statement_invoice")
  reconciledExpense RecurringExpense? @relation(fields: [reconciledExpenseId], references: [id], onUpdate: NoAction, map: "fk_bank_statement_expense")

  @@index([organizationId, date])
  @@index([organizationId, isReconciled], map: "idx_bank_statement_reconciled", where: raw("(is_reconciled = false)"))
  @@index([organizationId, fingerprint])
  dismissedMatches  DismissedMatch[]

  @@map("fin_bank_statement")
  @@schema("public")
}

model DismissedMatch {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  bankStatementId String   @map("bank_statement_id")
  targetId        String   @map("target_id")
  targetType      String   @map("target_type") // INVOICE, EXPENSE, EXPECTED_PAYABLE
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankStatement BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  @@unique([bankStatementId, targetId, targetType], map: "uq_dismissed_match")
  @@index([organizationId, bankStatementId])
  @@map("fin_dismissed_match")
  @@schema("public")
}

model CashflowSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  date           DateTime
  inflows        Decimal  @db.Decimal(12, 2)
  outflows       Decimal  @db.Decimal(12, 2)
  netFlow        Decimal  @map("net_flow") @db.Decimal(12, 2)
  balance        Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("fin_cashflow_snapshot")
  @@schema("public")
}

model ForecastScenario {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  parameters     Json     @default("{}")
  results        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fin_forecast_scenario")
  @@schema("public")
}

model FutureReceivable {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  description         String
  counterpart         String
  estimatedAmount     Decimal          @map("estimated_amount") @db.Decimal(12, 2)
  expectedInvoiceDate DateTime?        @map("expected_invoice_date")
  expectedPaymentDate DateTime?        @map("expected_payment_date")
  status              ReceivableStatus @default(PENDING)
  costCenterId        String?          @map("cost_center_id")
  invoiceId           String?          @map("invoice_id")
  notes               String?
  includeInForecast   Boolean          @default(true) @map("include_in_forecast")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fin_future_receivable")
  @@schema("public")
}

// ─── Fatture Passive Attese ──────────────────────────────────

model ExpectedPayable {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  description      String
  counterpart      String
  amount           Decimal          @db.Decimal(12, 2)
  frequency        ExpenseFrequency @default(MONTHLY)
  dayOfMonth       Int?             @map("day_of_month")
  startDate        DateTime         @map("start_date")
  endDate          DateTime?        @map("end_date")
  status           PayableStatus    @default(ACTIVE)
  costCenterId     String?          @map("cost_center_id")
  category         ExpenseCategory  @default(CONSULTING)
  notes            String?
  includeInForecast Boolean         @default(true) @map("include_in_forecast")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fin_expected_payable")
  @@schema("public")
}

// ─── Fase 2: Pagamenti Parziali ─────────────────────────────

model PaymentEvent {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  invoiceId        String?  @map("invoice_id")
  oneOffExpenseId  String?  @map("one_off_expense_id")
  amount           Decimal  @db.Decimal(15, 2)
  eventDate        DateTime @map("event_date") @db.Date
  isActual         Boolean  @default(false) @map("is_actual")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  oneOffExpense OneOffExpense? @relation(fields: [oneOffExpenseId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "idx_payment_event_invoice")
  @@index([oneOffExpenseId], map: "idx_payment_event_expense")
  @@index([organizationId, eventDate], map: "idx_payment_event_date")
  @@map("fin_payment_event")
  @@schema("public")
}

// ─── Fase 2: Snapshot IVA ───────────────────────────────────

model VatSnapshot {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  periodType      String   @map("period_type")
  vatDebit        Decimal  @default(0) @map("vat_debit") @db.Decimal(15, 2)
  vatCredit       Decimal  @default(0) @map("vat_credit") @db.Decimal(15, 2)
  vatBalance      Decimal  @default(0) @map("vat_balance") @db.Decimal(15, 2)
  carryForward    Decimal  @default(0) @map("carry_forward") @db.Decimal(15, 2)
  amountDue       Decimal  @default(0) @map("amount_due") @db.Decimal(15, 2)
  dueDate         DateTime? @map("due_date") @db.Date
  isPaid          Boolean  @default(false) @map("is_paid")
  paidDate        DateTime? @map("paid_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("fin_vat_snapshot")
  @@schema("public")
}

// ─── Fase 3: Onboarding + Dati Bancari Reali ─────────────

enum BalanceSource {
  EC_ANNUAL
  EC_QUARTERLY
  MANUAL

  @@map("fin_balance_source")
  @@schema("public")
}

enum DataPeriodType {
  EC_ANNUAL
  EC_QUARTERLY
  MOVEMENTS_CSV

  @@map("fin_data_period_type")
  @@schema("public")
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  bankName       String   @map("bank_name")
  iban           String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closingBalances  BalanceSnapshot[]
  bankProfile      BankProfile?
  bankStatements   BankStatement[]

  @@map("fin_bank_account")
  @@schema("public")
}

model BalanceSnapshot {
  id            String        @id @default(cuid())
  bankAccountId String        @map("bank_account_id")
  date          DateTime      @db.Date
  balance       Decimal       @db.Decimal(15, 2)
  source        BalanceSource
  period        String?
  sourceFile    String?       @map("source_file")
  createdAt     DateTime      @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, date, source])
  @@map("fin_balance_snapshot")
  @@schema("public")
}

model BankProfile {
  id                   String   @id @default(cuid())
  bankAccountId        String   @unique @map("bank_account_id")
  bankName             String   @map("bank_name")
  columnMapping        Json     @map("column_mapping")
  dateFormat           String   @default("dd/MM/yyyy") @map("date_format")
  delimiter            String   @default(",")
  decimalSeparator     String   @default(",") @map("decimal_separator")
  skipRows             Int      @default(0) @map("skip_rows")
  descriptionPatterns  Json?    @map("description_patterns")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("fin_bank_profile")
  @@schema("public")
}

model DataPeriod {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  type           DataPeriodType
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  sourceFile     String?        @map("source_file")
  recordCount    Int?           @map("record_count")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@map("fin_data_period")
  @@schema("public")
}

