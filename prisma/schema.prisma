generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ─── Enums ──────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER

  @@map("fin_user_role")
  @@schema("public")
}

enum ConnectorType {
  FATTURE_IN_CLOUD
  CSV_IMPORT
  MANUAL

  @@map("fin_connector_type")
  @@schema("public")
}

enum CostCenterType {
  COST
  REVENUE

  @@map("fin_cost_center_type")
  @@schema("public")
}

enum InvoiceDirection {
  ACTIVE
  PASSIVE

  @@map("fin_invoice_direction")
  @@schema("public")
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  DRAFT

  @@map("fin_invoice_status")
  @@schema("public")
}

enum ExpenseFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM

  @@map("fin_expense_frequency")
  @@schema("public")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SOFTWARE
  HARDWARE
  INSURANCE
  TAXES
  CONSULTING
  MARKETING
  TRAVEL
  TRAINING
  OTHER

  @@map("fin_expense_category")
  @@schema("public")
}

enum ReceivableStatus {
  PENDING
  INVOICED
  CANCELLED

  @@map("fin_receivable_status")
  @@schema("public")
}

// ─── Models ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  vatNumber String?  @map("vat_number")
  address   String?
  city      String?
  province  String?
  zipCode   String?  @map("zip_code")
  country   String   @default("IT")
  email     String?
  phone     String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  connectors         Connector[]
  costCenters        CostCenter[]
  invoices           Invoice[]
  recurringExpenses  RecurringExpense[]
  oneOffExpenses     OneOffExpense[]
  bankStatements     BankStatement[]
  cashflowSnapshots  CashflowSnapshot[]
  forecastScenarios  ForecastScenario[]
  futureReceivables  FutureReceivable[]

  @@map("fin_organization")
  @@schema("public")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String?      @map("password_hash")
  role           UserRole     @default(VIEWER)
  organizationId String       @map("organization_id")
  emailVerified  DateTime?    @map("email_verified")
  image          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]

  @@map("fin_user")
  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("fin_account")
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fin_session")
  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("fin_verification_token")
  @@schema("public")
}

model Connector {
  id              String        @id @default(cuid())
  organizationId  String        @map("organization_id")
  type            ConnectorType
  name            String
  encryptedConfig String?       @map("encrypted_config")
  isActive        Boolean       @default(true) @map("is_active")
  lastSyncAt      DateTime?     @map("last_sync_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fin_connector")
  @@schema("public")
}

model CostCenter {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  type           CostCenterType
  color          String         @default("#6B7280")
  keywords       String[]       @default([])
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  recurringExpenses  RecurringExpense[]
  oneOffExpenses     OneOffExpense[]
  bankStatements     BankStatement[]
  futureReceivables  FutureReceivable[]

  @@unique([organizationId, name])
  @@map("fin_cost_center")
  @@schema("public")
}

model Invoice {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  direction      InvoiceDirection
  status         InvoiceStatus    @default(PENDING)
  number         String
  date           DateTime
  dueDate        DateTime?        @map("due_date")
  counterpart    String
  vatNumber      String?          @map("vat_number")
  description    String?
  netAmount      Decimal          @map("net_amount") @db.Decimal(12, 2)
  vatAmount      Decimal          @map("vat_amount") @db.Decimal(12, 2)
  grossAmount    Decimal          @map("gross_amount") @db.Decimal(12, 2)
  costCenterId   String?          @map("cost_center_id")
  needsTagging   Boolean          @default(false) @map("needs_tagging")
  paidAt         DateTime?        @map("paid_at")
  connectorRef   String?          @map("connector_ref")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter         CostCenter?        @relation(fields: [costCenterId], references: [id])
  lines              InvoiceLine[]
  bankStatements     BankStatement[]
  futureReceivables  FutureReceivable[]

  @@index([organizationId, direction])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@map("fin_invoice")
  @@schema("public")
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String  @map("invoice_id")
  description  String
  quantity     Decimal @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  amount       Decimal @db.Decimal(12, 2)
  costCenterId String? @map("cost_center_id")

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@map("fin_invoice_line")
  @@schema("public")
}

model RecurringExpense {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  name            String
  category        ExpenseCategory
  frequency       ExpenseFrequency
  amount          Decimal          @db.Decimal(12, 2)
  vatIncluded     Boolean          @default(true) @map("vat_included")
  costCenterId    String?          @map("cost_center_id")
  startDate       DateTime         @map("start_date")
  endDate         DateTime?        @map("end_date")
  dayOfMonth      Int?             @map("day_of_month")
  customDays      Int?             @map("custom_days")
  description     String?
  counterpart     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@map("fin_recurring_expense")
  @@schema("public")
}

model OneOffExpense {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  vatIncluded    Boolean         @default(true) @map("vat_included")
  costCenterId   String?         @map("cost_center_id")
  date           DateTime
  isPaid         Boolean         @default(false) @map("is_paid")
  paidAt         DateTime?       @map("paid_at")
  description    String?
  counterpart    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@map("fin_one_off_expense")
  @@schema("public")
}

model BankStatement {
  id                    String       @id @default(cuid())
  organizationId        String       @map("organization_id")
  date                  DateTime
  description           String
  amount                Decimal      @db.Decimal(12, 2)
  balance               Decimal      @db.Decimal(12, 2)
  costCenterId          String?      @map("cost_center_id")
  reference             String?
  sourceFile            String?      @map("source_file")
  isReconciled          Boolean      @default(false) @map("is_reconciled")
  reconciledInvoiceId   String?      @map("reconciled_invoice_id")
  reconciledAt          DateTime?    @map("reconciled_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter        CostCenter?  @relation(fields: [costCenterId], references: [id])
  reconciledInvoice Invoice?     @relation(fields: [reconciledInvoiceId], references: [id], onUpdate: NoAction, map: "fk_bank_statement_invoice")

  @@index([organizationId, date])
  @@index([organizationId, isReconciled], map: "idx_bank_statement_reconciled", where: raw("(is_reconciled = false)"))
  @@map("fin_bank_statement")
  @@schema("public")
}

model CashflowSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  date           DateTime
  inflows        Decimal  @db.Decimal(12, 2)
  outflows       Decimal  @db.Decimal(12, 2)
  netFlow        Decimal  @map("net_flow") @db.Decimal(12, 2)
  balance        Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("fin_cashflow_snapshot")
  @@schema("public")
}

model ForecastScenario {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  parameters     Json     @default("{}")
  results        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fin_forecast_scenario")
  @@schema("public")
}

model FutureReceivable {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  description         String
  counterpart         String
  estimatedAmount     Decimal          @map("estimated_amount") @db.Decimal(12, 2)
  expectedInvoiceDate DateTime?        @map("expected_invoice_date")
  expectedPaymentDate DateTime?        @map("expected_payment_date")
  status              ReceivableStatus @default(PENDING)
  costCenterId        String?          @map("cost_center_id")
  invoiceId           String?          @map("invoice_id")
  notes               String?
  includeInForecast   Boolean          @default(true) @map("include_in_forecast")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fin_future_receivable")
  @@schema("public")
}
